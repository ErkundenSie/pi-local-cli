{
  "name": "pi-local-cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Use local AI coding CLIs (Codex, Claude Code, Antigravity, Grok Build) as models in Pi",
  "license": "MIT",
  "author": "ErkundenSie",
  "repository": { "type": "git", "url": "git+https://github.com/ErkundenSie/pi-local-cli.git" },
  "homepage": "https://github.com/ErkundenSie/pi-local-cli#readme",
  "bugs": { "url": "https://github.com/ErkundenSie/pi-local-cli/issues" },
  "engines": { "node": ">=22" },
  "keywords": [
    "pi-package",
    "pi-extension",
    "local-cli",
    "acp",
    "agent-client-protocol",
    "codex",
    "claude-code",
    "antigravity",
    "grok",
    "mcp"
  ],
  "pi": { "extensions": ["./index.mjs"] },
  "files": ["index.mjs", "lib", "README.md", "README.zh-CN.md", "LICENSE"],
  "peerDependencies": { "@earendil-works/pi-ai": "*", "@earendil-works/pi-coding-agent": "*" },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true }
  },
  "dependencies": { "smol-toml": "^1.7.0" },
  "scripts": { "test": "node --test test/*.test.mjs", "doctor": "node scripts/doctor.mjs" }
}
